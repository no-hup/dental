# SignalWire
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE=yourspace.signalwire.com
SIGNALWIRE_PHONE_NUMBER=+15551234567
DISPLAY_PHONE_NUMBER=
SWML_BASIC_AUTH_USER=
SWML_BASIC_AUTH_PASSWORD=
SWML_PROXY_URL_BASE=

# Mock Mode (set to true to use local SQLite instead of real OpenDental API)
MOCK_MODE=false

# OpenDental API
OPENDENTAL_BASE_URL=https://api.opendental.com/api/v1
OPENDENTAL_DEVELOPER_KEY=
OPENDENTAL_CUSTOMER_KEY=

# Practice Info
PRACTICE_NAME=Smile Dental

# AI Model
AI_MODEL=gpt-oss-120b
AI_TOP_P=0.5
AI_TEMPERATURE=0.5

# Server
HOST=0.0.0.0
PORT=3000

# Outbound Confirmation Agent
OUTBOUND_ENABLED=false
OUTBOUND_SCHEDULE=0 9 * * 1-5
CONFIRM_WINDOW_DAYS=3
RECALL_WINDOW_DAYS=14
MAX_OUTBOUND_CONCURRENT=2
OUTBOUND_CALLER_ID=
